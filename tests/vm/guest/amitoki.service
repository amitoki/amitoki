[Unit]
Description=amitoki relay in the test VM
Requires=amitoki-network.service
After=amitoki-network.service network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=amitoki
ExecStart=/opt/amitoki-lab/amitoki --config /opt/amitoki-lab/amitoki.toml
Environment=AMITOKI_PLUGIN_DIR=/opt/amitoki-lab/plugins
EnvironmentFile=/opt/amitoki-lab/postgres.env
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=yes
Restart=on-failure
# DBの起動待ちや占有接続切断後の再接続を、プロセス再起動で行う。
RestartSec=2
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
