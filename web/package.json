{
  "name": "amitoki-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "test": "node test-browser.mjs",
    "format": "prettier --write src vite.config.ts tsconfig.json index.html test-browser.mjs dev-server.mjs",
    "format:check": "prettier --check src vite.config.ts tsconfig.json index.html test-browser.mjs dev-server.mjs",
    "test:dev": "node test-browser.mjs --dev"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
